CBLB29 blb29 0 160f
CBL30  bl30  0 160f
CBLB30 blb30 0 160f
CBL31  bl31  0 160f
CBLB31 blb31 0 160f

* ---- precharge PMOS (pre = 0 -> ON) ----
MPRE0   bl0   pre vdd vdd PMOS W=4u L=1u
MPREB0  blb0  pre vdd vdd PMOS W=4u L=1u
MPRE1   bl1   pre vdd vdd PMOS W=4u L=1u
MPREB1  blb1  pre vdd vdd PMOS W=4u L=1u
