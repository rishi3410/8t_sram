MPREB22 blb22 pre vdd vdd PMOS W=4u L=1u
MPRE23  bl23  pre vdd vdd PMOS W=4u L=1u
MPREB23 blb23 pre vdd vdd PMOS W=4u L=1u
MPRE24  bl24  pre vdd vdd PMOS W=4u L=1u
MPREB24 blb24 pre vdd vdd PMOS W=4u L=1u
MPRE25  bl25  pre vdd vdd PMOS W=4u L=1u
MPREB25 blb25 pre vdd vdd PMOS W=4u L=1u
MPRE26  bl26  pre vdd vdd PMOS W=4u L=1u
MPREB26 blb26 pre vdd vdd PMOS W=4u L=1u
MPRE27  bl27  pre vdd vdd PMOS W=4u L=1u
MPREB27 blb27 pre vdd vdd PMOS W=4u L=1u
MPRE28  bl28  pre vdd vdd PMOS W=4u L=1u
MPREB28 blb28 pre vdd vdd PMOS W=4u L=1u
MPRE29  bl29  pre vdd vdd PMOS W=4u L=1u
MPREB29 blb29 pre vdd vdd PMOS W=4u L=1u
MPRE30  bl30  pre vdd vdd PMOS W=4u L=1u
MPREB30 blb30 pre vdd vdd PMOS W=4u L=1u
MPRE31  bl31  pre vdd vdd PMOS W=4u L=1u
MPREB31 blb31 pre vdd vdd PMOS W=4u L=1u
VPRE pre 0 PWL(0n 0 9.9n 0 10n 1 55n 1 55.1n 0 63n 0 63.1n 1 85n 1 85.1n 0 93n 0 93.1n 1 115n 1 115.1n 0 123n 0 123.1n 1 145n 1 145.1n 0 153n 0 153.1n 1)

* ---- write drivers: data source -> switch -> bit-line (wen = 1 -> connected) ----
.model SWMOD SW (VT=0.5 VH=0.1 RON=200 ROFF=1G)
SBL0   bld0   bl0   wen 0 SWMOD
SBLB0  bldb0  blb0  wen 0 SWMOD
SBL1   bld1   bl1   wen 0 SWMOD
SBLB1  bldb1  blb1  wen 0 SWMOD
SBL2   bld2   bl2   wen 0 SWMOD
SBLB2  bldb2  blb2  wen 0 SWMOD
