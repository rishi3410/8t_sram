* ==========================================
* tb_array_32x32.cir  -  32x32 6T SRAM array: write / read / retention test
* Row0: alternating 0101... -> write 1010...   Row1: alternating 1010... -> write 0101...
* Row2 and Row3 (along with Rows 4..31) are NEVER written (retention check)
* Digits are listed in column order C0..C31
* ==========================================

.include sram6t_cell.inc
.include sram_array_32x32.inc

.param VDDVAL=1.0
VDD vdd 0 {VDDVAL}

* ---- bit-line capacitances (scaled to 160f for 32 cells per column) ----
CBL0   bl0   0 160f
CBLB0  blb0  0 160f
CBL1   bl1   0 160f
CBLB1  blb1  0 160f
CBL2   bl2   0 160f
CBLB2  blb2  0 160f
